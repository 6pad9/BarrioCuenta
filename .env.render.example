# Plantilla para Render. Copiar los valores en Environment del servicio.
# No subir una copia con claves reales a GitHub.
APP_MODE=production
MAIL_PROVIDER=brevo
AUTO_PROCESS_CUTS=1
AUTO_CUTS_INTERVAL_SECONDS=60
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=BarrioCuenta
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# PUBLIC_URL es opcional: Render proporciona su URL automáticamente.
# PUBLIC_URL=https://TU-SERVICIO.onrender.com
